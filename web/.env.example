# Vorlage für lokale Entwicklung: als .env.local kopieren (wird nicht eingecheckt).
# Auf Vercel dieselben Namen unter Project → Settings → Environment Variables (Production und Preview) eintragen.

# Neon → Connect → „Pooled connection“ (Host mit -pooler), endet auf ?sslmode=require
DATABASE_URL=postgres://benutzer:passwort@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# mindestens 32 Zeichen, z. B. mit: openssl rand -base64 32
BETTER_AUTH_SECRET=

# öffentliche Adresse der App (auf Vercel die Produktions-Domain, lokal http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000

# Dieses Konto wird beim Registrieren Admin (solange es noch keinen Admin gibt) und schaltet Lehrkräfte frei
ADMIN_BENUTZERNAME=
